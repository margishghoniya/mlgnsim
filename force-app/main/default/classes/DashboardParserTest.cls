@IsTest
private class DashboardParserTest {

    /**
     * Test parseDashboard() with valid JSON
     */
    @IsTest
    static void testParseDashboardSuccess() {

        String json =
        '{' +
            '"dashboardTitle":"Loan Dashboard",' +
            '"dashboardDescription":"Loan Risk Analysis",' +
            '"generatedBy":"Claude AI",' +
            '"overallRisk":"Low",' +
            '"overallScore":91.5' +
        '}';

        Test.startTest();

        DashboardWrapper dashboard =
            DashboardParser.parseDashboard(json);

        Test.stopTest();

        System.assertNotEquals(null, dashboard);
        System.assertEquals('Loan Dashboard', dashboard.dashboardTitle);
        System.assertEquals('Loan Risk Analysis', dashboard.dashboardDescription);
        System.assertEquals('Claude AI', dashboard.generatedBy);
        System.assertEquals('Low', dashboard.overallRisk);
        System.assertEquals(91.5, dashboard.overallScore);

        System.assertNotEquals(null, dashboard.charts);
        System.assertNotEquals(null, dashboard.records);
        System.assertNotEquals(null, dashboard.warnings);
    }

    /**
     * Test default values
     */
    @IsTest
    static void testDashboardDefaults() {

        String json = '{}';

        DashboardWrapper dashboard =
            DashboardParser.parseDashboard(json);

        System.assertEquals('AI Dashboard', dashboard.dashboardTitle);
        System.assertEquals('Generated by Claude AI',
                            dashboard.dashboardDescription);
        System.assertEquals('Claude AI', dashboard.generatedBy);

        System.assertNotEquals(null, dashboard.generatedOn);
        System.assertNotEquals(null, dashboard.charts);
        System.assertNotEquals(null, dashboard.records);
        System.assertNotEquals(null, dashboard.warnings);
    }

    /**
     * Test empty JSON
     */
    @IsTest
    static void testEmptyJson() {

        Test.startTest();

        try{

            DashboardParser.parseDashboard('');

            System.assert(false,'Exception expected');

        }catch(ClaudeException ex){

            System.assert(
                ex.getMessage().contains('Claude returned an empty response.')
            );

        }

        Test.stopTest();

    }

    /**
     * Test invalid dashboard JSON
     */
    @IsTest
    static void testInvalidDashboardJson() {

        String json = '{Invalid JSON}';

        Test.startTest();

        try{

            DashboardParser.parseDashboard(json);

            System.assert(false);

        }catch(ClaudeException ex){

            System.assert(
                ex.getMessage().contains('Unable to parse dashboard JSON')
            );

        }

        Test.stopTest();

    }

    /**
     * Test parseClaudeResponse()
     */
    @IsTest
    static void testParseClaudeResponse() {

        String responseJson =
        '{' +
        '"id":"msg_001",' +
        '"type":"message",' +
        '"role":"assistant",' +
        '"model":"claude-sonnet-5",' +
        '"stop_reason":"end_turn",' +
        '"content":[]' +
        '}';

        Test.startTest();

        ClaudeWrapper.Response response =
            DashboardParser.parseClaudeResponse(responseJson);

        Test.stopTest();

        System.assertNotEquals(null,response);
        System.assertEquals('msg_001',response.id);

    }

    /**
     * Test parseClaudeResponse() invalid JSON
     */
    @IsTest
    static void testParseClaudeResponseInvalid() {

        Test.startTest();

        try{

            DashboardParser.parseClaudeResponse('{');

            System.assert(false);

        }catch(ClaudeException ex){

            System.assert(
                ex.getMessage().contains('PARSER_ERROR')
                ||
                ex.getMessage().length()>0
            );

        }

        Test.stopTest();

    }

    /**
     * Test parseError() valid JSON
     */
    @IsTest
    static void testParseErrorSuccess(){

        String json =
        '{' +
            '"type":"error",' +
            '"error":{' +
                '"type":"invalid_request_error",' +
                '"message":"Bad Request"' +
            '}' +
        '}';

        ClaudeWrapper.ErrorResponse err =
            DashboardParser.parseError(json);

        System.assertEquals(
            'invalid_request_error',
            err.error.type
        );

        System.assertEquals(
            'Bad Request',
            err.error.message
        );

    }

    /**
     * Test parseError() invalid JSON
     */
    @IsTest
    static void testParseErrorInvalid(){

        ClaudeWrapper.ErrorResponse err =
            DashboardParser.parseError('{');

        System.assertEquals(
            'api_error',
            err.type
        );

        System.assertEquals(
            'unknown_error',
            err.error.type
        );

        System.assertNotEquals(
            null,
            err.error.message
        );

    }

    /**
     * Test prettyPrint()
     */
    @IsTest
    static void testPrettyPrint(){

        DashboardWrapper dashboard =
            new DashboardWrapper();

        dashboard.dashboardTitle='Loan Dashboard';

        String json =
            DashboardParser.prettyPrint(dashboard);

        System.assert(
            json.contains('Loan Dashboard')
        );

    }

    /**
     * Test toJson()
     */
    @IsTest
    static void testToJson(){

        DashboardWrapper dashboard =
            new DashboardWrapper();

        dashboard.dashboardTitle='Claude Dashboard';

        String json =
            DashboardParser.toJson(dashboard);

        System.assert(
            json.contains('Claude Dashboard')
        );

    }

}