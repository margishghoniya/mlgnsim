/**
* ==========================================================
* Class Name    : DashboardParser
* Description   : Parses Claude AI response into
*                 DashboardWrapper
* ==========================================================
*/
public without sharing class DashboardParser {
    
    /**
* Parse Dashboard JSON
*/
    public static DashboardWrapper parseDashboard(String jsonResponse) {
        
        validateJson(jsonResponse);
        
        try {
            
            DashboardWrapper dashboard =
                (DashboardWrapper)System.JSON.deserialize(
                    jsonResponse,
                    DashboardWrapper.class
                );
            
            applyDefaults(dashboard);
            
            validateDashboard(dashboard);
            
            return dashboard;
            
        } catch (Exception ex) {
            
            throw new ClaudeException('PARSER_ERROR','Unable to parse dashboard JSON. ' +ex.getMessage());
        }
    }
    
    /**
* Parse Claude Response
*/
    public static ClaudeWrapper.Response parseClaudeResponse(String json) {
        
        validateJson(json);
        
        try {
            
            return (ClaudeWrapper.Response)
                System.JSON.deserialize(json, ClaudeWrapper.Response.class);
        } catch (Exception ex) {
            throw new ClaudeException(
                'PARSER_ERROR',
                ex.getMessage()
            );
        }
    }
    
    /*Parse Claude Error
*/
    public static ClaudeWrapper.ErrorResponse parseError(String json){
        
        try{
            
            return (ClaudeWrapper.ErrorResponse)
                System.JSON.deserialize(json, ClaudeWrapper.ErrorResponse.class);
        }catch(Exception ex){
            
            ClaudeWrapper.ErrorResponse err = new ClaudeWrapper.ErrorResponse();
            
            err.type = 'api_error';
            
            err.error = new ClaudeWrapper.Error();
            
            err.error.type = 'unknown_error';
            
            err.error.message = ex.getMessage();
            
            return err;
        }
    }
    
    /**
* Validate JSON
*/
    private static void validateJson(String json){
        
        if(String.isBlank(json)){
            
            throw new ClaudeException('EMPTY_RESPONSE','Claude returned an empty response.');
        }
    }
    
    /**
* Apply Default Values
*/
    private static void applyDefaults(DashboardWrapper dashboard){
        
        if(dashboard == null){
            
            dashboard = new DashboardWrapper();
        }
        
        if(dashboard.generatedOn == null){
            
            dashboard.generatedOn = System.now();
        }
        
        if(String.isBlank(dashboard.generatedBy)){
            
            dashboard.generatedBy = 'Claude AI';
        }
        
        if(dashboard.charts == null){
            
            dashboard.charts =
                new List<ChartWrapper>();
        }
        
        if(dashboard.records == null){
            
            dashboard.records =
                new List<DashboardWrapper.DashboardRecord>();
        }
        
        if(dashboard.warnings == null){
            
            dashboard.warnings =
                new List<String>();
        }
        
    }
    
    /**
* Validate Dashboard
*/
    private static void validateDashboard(
        DashboardWrapper dashboard){
            
            if(dashboard == null){
                
                throw new ClaudeException(
                    'INVALID_DASHBOARD',
                    'Dashboard is null.'
                );
            }
            
            if(String.isBlank(dashboard.dashboardTitle)){
                
                dashboard.dashboardTitle =
                    'AI Dashboard';
            }
            
            if(String.isBlank(
                dashboard.dashboardDescription)){
                    
                    dashboard.dashboardDescription =
                        'Generated by Claude AI';
                }
            
        }
    
    /**
* Pretty JSON
*/
    public static String prettyPrint(
        DashboardWrapper dashboard){
            
            return System.JSON.serializePretty(dashboard);
            
        }
    
    /**
* Serialize Dashboard
*/
    public static String toJson(
        DashboardWrapper dashboard){
            
            return System.JSON.serialize(dashboard);
            
        }
    
}